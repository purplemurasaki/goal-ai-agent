# Copy to .env.local (do not commit secrets)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_JWT_SECRET=
# Supabase はユーザートークンを ES256(非対称鍵) で署名するため JWKS で検証する。
# Docker で API を動かす場合は http://host.docker.internal:54321/auth/v1/.well-known/jwks.json に変更。
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL_COACH=gpt-4o-mini
OPENAI_MODEL_DECOMPOSE=gpt-4o
OPENAI_MODEL_REVIEW=gpt-4o-mini
AI_DAILY_LIMIT=50
